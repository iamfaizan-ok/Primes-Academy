# Primes Academy Backend Configuration
DJANGO_SECRET_KEY=change-in-production-primes-academy-key
DEBUG=True

# Database Configuration (PostgreSQL)
# Either provide DATABASE_URL directly or use individual DB_* settings:
# DATABASE_URL=postgres://postgres:password@localhost:5432/primesAcademy
# Or set USE_SQLITE=True for local zero-config development:
# USE_SQLITE=False
DB_NAME=primesAcademy
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# Admin Initialization Defaults
ADMIN_EMAIL=admin@primesacademy.com
ADMIN_PASSWORD=admin123

