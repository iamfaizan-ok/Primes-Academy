# Primes Academy Configuration
# PostgreSQL is the sole database engine for development and production.

# Backend Environment Variables
DJANGO_SECRET_KEY=change-in-production-primes-academy-key
DEBUG=True

# Database Configuration (PostgreSQL Only)
# Either provide DATABASE_URL directly or configure individual DB_* settings:
# DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/primesAcademy
DB_NAME=primesAcademy
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=600

# Admin Initialization Credentials
ADMIN_EMAIL=admin@primesacademy.com
ADMIN_PASSWORD=admin123

# Frontend Environment Variables
VITE_API_BASE_URL=/api
